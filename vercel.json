{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/send-rebaixa-email.ts": {
      "maxDuration": 60
    },
    "api/ai-assist.ts": {
      "maxDuration": 60
    },
    "api/manage-validade.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/manage-validade",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/manage-validade",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/index.html"
    }
  ]
}
